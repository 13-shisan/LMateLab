worker_processes 1;
pid /home/Pwjb/.config/lmatelab-107cup-proxy/run/nginx.pid;
error_log /home/Pwjb/.config/lmatelab-107cup-proxy/log/error.log warn;

events {
    worker_connections 256;
}

http {
    access_log /home/Pwjb/.config/lmatelab-107cup-proxy/log/access.log;
    client_body_temp_path /home/Pwjb/.config/lmatelab-107cup-proxy/client-body;
    proxy_temp_path /home/Pwjb/.config/lmatelab-107cup-proxy/proxy-temp;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;

    server {
        listen 18733;
        server_name _;

        allow 127.0.0.1;
        allow ::1;
        allow 114.214.207.67;
        allow 114.214.197.96;
        allow 114.214.196.227;
        allow 114.214.200.167;
        allow 114.214.200.115;
        allow 114.214.200.139;
        allow 114.214.201.221;
        allow 114.214.196.32;
        allow 114.214.203.186;
        allow 114.214.207.227;
        allow 114.214.207.205;
        allow 114.214.196.22;
        allow 114.214.196.195;
        allow 114.214.205.83;
        allow 114.214.196.34;
        allow 114.214.203.210;
        allow 211.86.0.0/16;
        allow 210.45.118.14;
        allow 222.195.94.37;
        deny all;

        location = /api/auth/login {
            limit_except POST {
                deny all;
            }
            proxy_pass http://127.0.0.1:18734;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/auth/change-password {
            limit_except POST {
                deny all;
            }
            proxy_pass http://127.0.0.1:18734;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            limit_except GET {
                deny all;
            }
            proxy_pass http://127.0.0.1:18734;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            limit_except GET {
                deny all;
            }
            proxy_pass http://127.0.0.1:18734;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
